---
/** Logo provisorio: un globo de diálogo con un destello (la idea de "pedirle" algo a la IA). */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <defs>
    <linearGradient id="pt-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6d4aff"></stop>
      <stop offset="1" stop-color="#ff6b5b"></stop>
    </linearGradient>
  </defs>
  <path d="M10 4h28a8 8 0 0 1 8 8v18a8 8 0 0 1-8 8H22l-9 7v-7h-3a8 8 0 0 1-8-8V12a8 8 0 0 1 8-8z" fill="url(#pt-g)"></path>
  <path d="M24 10c.9 5.6 3.4 8.1 9 9-5.6.9-8.1 3.4-9 9-.9-5.6-3.4-8.1-9-9 5.6-.9 8.1-3.4 9-9z" fill="#fff"></path>
  <circle cx="34.5" cy="28.5" r="2.2" fill="#fff" opacity=".85"></circle>
</svg>
