---
import AreaCard from '../../components/AreaCard.astro';
import Base from '../../layouts/Base.astro';
import { SECTIONS } from '../../sections';

export function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section: section.id }, props: { section } }));
}

const { section } = Astro.props;
---

<Base title={section.seo.title} description={section.seo.description}>
  <section class="container head">
    <h1>{section.title.es}</h1>
    <p class="muted lead">{section.description.es}</p>
    <div class="areas">
      {section.areas.map((area) => <AreaCard sectionId={section.id} area={area} />)}
    </div>
  </section>
</Base>

<style>
  .head {
    padding-top: 2.5rem;
  }
  .lead {
    max-width: 62ch;
    font-size: 1.1rem;
  }
  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
